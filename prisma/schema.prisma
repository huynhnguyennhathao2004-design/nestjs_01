generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  LOCKED
  UNVERIFIED
  DISABLED
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum DestinationStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum DestinationImageType {
  COVER
  GALLERY
  THUMBNAIL
}

enum ContentBlockType {
  TRANSPORTATION
  OPENING_HOURS
  TICKET_PRICE
  TRAVEL_NOTE
  BEST_TIME
  OTHER
}

enum TtsJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum StorageProvider {
  CLOUDFLARE_R2
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.VarChar(320)
  fullName        String     @map("full_name") @db.VarChar(120)
  passwordHash    String?    @map("password_hash") @db.VarChar(255)
  tokenVersion    Int        @default(0) @map("token_version")
  avatarUrl       String?    @map("avatar_url") @db.Text
  role            UserRole   @default(USER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)

  authAccounts            AuthAccount[]
  refreshSessions         RefreshSession[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  createdDestinations     Destination[]            @relation("DestinationCreatedBy")
  updatedDestinations     Destination[]            @relation("DestinationUpdatedBy")
  ttsJobs                 TtsJob[]
  audioDownloads          AudioDownload[]
  destinationViews        DestinationView[]
  searchLogs              SearchLog[]
  auditLogs               AuditLog[]
  updatedSiteSettings     SiteSetting[]

  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model AuthAccount {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id") @db.VarChar(320)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("auth_accounts")
}

model RefreshSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  userAgent        String?   @map("user_agent") @db.Text
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model Region {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  slug      String   @unique @db.VarChar(120)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  provinces  Province[]
  searchLogs SearchLog[]

  @@index([sortOrder])
  @@map("regions")
}

model Province {
  id        String   @id @default(uuid()) @db.Uuid
  regionId  String   @map("region_id") @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(140)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  region       Region        @relation(fields: [regionId], references: [id], onDelete: Restrict)
  destinations Destination[]

  @@unique([regionId, name])
  @@index([regionId])
  @@map("provinces")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(120)
  slug        String   @unique @db.VarChar(140)
  description String?  @db.Text
  icon        String?  @db.VarChar(120)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  destinationCategories DestinationCategory[]
  primaryDestinations   Destination[]         @relation("PrimaryDestinationCategory")
  searchLogs            SearchLog[]

  @@index([isActive])
  @@map("categories")
}

model DestinationCategory {
  destinationId String   @map("destination_id") @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([destinationId, categoryId])
  @@index([categoryId])
  @@map("destination_categories")
}

model Destination {
  id                String            @id @default(uuid()) @db.Uuid
  provinceId        String            @map("province_id") @db.Uuid
  primaryCategoryId String?           @map("primary_category_id") @db.Uuid
  slug              String            @unique @db.VarChar(180)
  name              String            @db.VarChar(180)
  shortDescription  String?           @map("short_description") @db.VarChar(500)
  description       String            @db.Text
  bestTravelTime    String?           @map("best_travel_time") @db.VarChar(255)
  mapQuery          String?           @map("map_query") @db.Text
  latitude          Decimal?          @db.Decimal(9, 6)
  longitude         Decimal?          @db.Decimal(10, 6)
  status            DestinationStatus @default(DRAFT)
  isFeatured        Boolean           @default(false) @map("is_featured")
  metaTitle         String?           @map("meta_title") @db.VarChar(255)
  metaDescription   String?           @map("meta_description") @db.VarChar(500)
  createdById       String?           @map("created_by_id") @db.Uuid
  updatedById       String?           @map("updated_by_id") @db.Uuid
  publishedAt       DateTime?         @map("published_at") @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz(3)

  province        Province  @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  primaryCategory Category? @relation("PrimaryDestinationCategory", fields: [primaryCategoryId], references: [id], onDelete: SetNull)
  createdBy       User?     @relation("DestinationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?     @relation("DestinationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  categories        DestinationCategory[]
  images            DestinationImage[]
  features          DestinationFeature[]
  attractions       DestinationAttraction[]
  foods             DestinationFood[]
  contentBlocks     DestinationContentBlock[]
  ttsJobs           TtsJob[]
  views             DestinationView[]
  clickedSearchLogs SearchLog[]

  @@index([provinceId])
  @@index([primaryCategoryId])
  @@index([status, publishedAt])
  @@index([isFeatured])
  @@index([deletedAt])
  @@map("destinations")
}

model DestinationImage {
  id            String               @id @default(uuid()) @db.Uuid
  destinationId String               @map("destination_id") @db.Uuid
  url           String               @db.Text
  storageKey    String?              @unique @map("storage_key") @db.VarChar(500)
  altText       String?              @map("alt_text") @db.VarChar(255)
  imageType     DestinationImageType @default(GALLERY) @map("image_type")
  sourceUrl     String?              @map("source_url") @db.Text
  imageCredit   String?              @map("image_credit") @db.VarChar(255)
  sortOrder     Int                  @default(0) @map("sort_order")
  isActive      Boolean              @default(true) @map("is_active")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId, imageType, sortOrder])
  @@index([isActive])
  @@map("destination_images")
}

model DestinationFeature {
  id            String   @id @default(uuid()) @db.Uuid
  destinationId String   @map("destination_id") @db.Uuid
  title         String   @db.VarChar(180)
  content       String   @db.Text
  icon          String?  @db.VarChar(120)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId, sortOrder])
  @@map("destination_features")
}

model DestinationAttraction {
  id            String   @id @default(uuid()) @db.Uuid
  destinationId String   @map("destination_id") @db.Uuid
  name          String   @db.VarChar(180)
  description   String?  @db.Text
  address       String?  @db.VarChar(500)
  mapQuery      String?  @map("map_query") @db.Text
  latitude      Decimal? @db.Decimal(9, 6)
  longitude     Decimal? @db.Decimal(10, 6)
  imageUrl      String?  @map("image_url") @db.Text
  imageAlt      String?  @map("image_alt") @db.VarChar(255)
  sourceUrl     String?  @map("source_url") @db.Text
  imageCredit   String?  @map("image_credit") @db.VarChar(255)
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId, sortOrder])
  @@index([isActive])
  @@map("destination_attractions")
}

model DestinationFood {
  id            String   @id @default(uuid()) @db.Uuid
  destinationId String   @map("destination_id") @db.Uuid
  name          String   @db.VarChar(180)
  description   String?  @db.Text
  imageUrl      String?  @map("image_url") @db.Text
  imageAlt      String?  @map("image_alt") @db.VarChar(255)
  priceMin      Int?     @map("price_min")
  priceMax      Int?     @map("price_max")
  priceNote     String?  @map("price_note") @db.VarChar(255)
  suggestedArea String?  @map("suggested_area") @db.VarChar(255)
  sourceUrl     String?  @map("source_url") @db.Text
  imageCredit   String?  @map("image_credit") @db.VarChar(255)
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId, sortOrder])
  @@index([isActive])
  @@map("destination_foods")
}

model DestinationContentBlock {
  id            String           @id @default(uuid()) @db.Uuid
  destinationId String           @map("destination_id") @db.Uuid
  type          ContentBlockType
  title         String           @db.VarChar(180)
  content       String           @db.Text
  sortOrder     Int              @default(0) @map("sort_order")
  isActive      Boolean          @default(true) @map("is_active")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId, type, sortOrder])
  @@index([isActive])
  @@map("destination_content_blocks")
}

model TtsJob {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String?      @map("user_id") @db.Uuid
  destinationId  String?      @map("destination_id") @db.Uuid
  runpodJobId    String?      @unique @map("runpod_job_id") @db.VarChar(255)
  sourceText     String       @map("source_text") @db.Text
  normalizedText String?      @map("normalized_text") @db.Text
  inputHash      String       @map("input_hash") @db.VarChar(64)
  voiceCode      String?      @map("voice_code") @db.VarChar(100)
  modelName      String?      @map("model_name") @db.VarChar(100)
  modelVersion   String?      @map("model_version") @db.VarChar(100)
  status         TtsJobStatus @default(QUEUED)
  errorCode      String?      @map("error_code") @db.VarChar(100)
  errorMessage   String?      @map("error_message") @db.Text
  queuedAt       DateTime     @default(now()) @map("queued_at") @db.Timestamptz(3)
  startedAt      DateTime?    @map("started_at") @db.Timestamptz(3)
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  audioFile   AudioFile?

  @@index([userId])
  @@index([destinationId])
  @@index([status, createdAt])
  @@index([inputHash, voiceCode, status])
  @@map("tts_jobs")
}

model AudioFile {
  id              String          @id @default(uuid()) @db.Uuid
  ttsJobId        String          @unique @map("tts_job_id") @db.Uuid
  storageProvider StorageProvider @default(CLOUDFLARE_R2) @map("storage_provider")
  bucketName      String          @map("bucket_name") @db.VarChar(255)
  objectKey       String          @unique @map("object_key") @db.VarChar(500)
  publicUrl       String          @map("public_url") @db.Text
  mimeType        String          @default("audio/wav") @map("mime_type") @db.VarChar(100)
  fileExtension   String          @default("wav") @map("file_extension") @db.VarChar(20)
  sizeBytes       Int?            @map("size_bytes")
  durationSeconds Decimal?        @map("duration_seconds") @db.Decimal(10, 3)
  checksum        String?         @db.VarChar(128)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(3)

  ttsJob    TtsJob          @relation(fields: [ttsJobId], references: [id], onDelete: Cascade)
  downloads AudioDownload[]

  @@index([deletedAt])
  @@map("audio_files")
}

model AudioDownload {
  id          String   @id @default(uuid()) @db.Uuid
  audioFileId String   @map("audio_file_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  ipHash      String?  @map("ip_hash") @db.VarChar(128)
  userAgent   String?  @map("user_agent") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  audioFile AudioFile @relation(fields: [audioFileId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([audioFileId, createdAt])
  @@index([userId])
  @@map("audio_downloads")
}

model DestinationView {
  id            String   @id @default(uuid()) @db.Uuid
  destinationId String   @map("destination_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  visitorId     String?  @map("visitor_id") @db.VarChar(128)
  sessionId     String?  @map("session_id") @db.VarChar(128)
  ipHash        String?  @map("ip_hash") @db.VarChar(128)
  userAgent     String?  @map("user_agent") @db.Text
  viewedAt      DateTime @default(now()) @map("viewed_at") @db.Timestamptz(3)

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([destinationId, viewedAt])
  @@index([userId])
  @@index([visitorId])
  @@map("destination_views")
}

model SearchLog {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String?  @map("user_id") @db.Uuid
  query                String   @db.VarChar(500)
  regionId             String?  @map("region_id") @db.Uuid
  categoryId           String?  @map("category_id") @db.Uuid
  resultsCount         Int      @default(0) @map("results_count")
  clickedDestinationId String?  @map("clicked_destination_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user               User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  region             Region?      @relation(fields: [regionId], references: [id], onDelete: SetNull)
  category           Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  clickedDestination Destination? @relation(fields: [clickedDestinationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([regionId])
  @@index([categoryId])
  @@index([clickedDestinationId])
  @@index([createdAt])
  @@map("search_logs")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.VarChar(128)
  oldData     Json?    @map("old_data")
  newData     Json?    @map("new_data")
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model SiteSetting {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(120)
  value       Json
  valueType   SettingValueType @default(STRING) @map("value_type")
  description String?          @db.Text
  isPublic    Boolean          @default(false) @map("is_public")
  updatedById String?          @map("updated_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isPublic])
  @@index([updatedById])
  @@map("site_settings")
}
